    ],
    "build": {
      "tool": "go",
      "command": "go build ./...",
      "check_command": "go vet ./..."
    },
    "test": {
      "runner": "go test",
      "command": "go test ./...",
      "directory": "co-located *_test.go files (Go convention)",
      "integration_command": "go test -tags=integration ./..."
    },
    "lint": {
      "tool": "golangci-lint",
      "command": "golangci-lint run",
      "config": ".golangci.yml"
    },
    "format": {
      "tool": "gofmt",
      "command": "gofmt -l .",
      "check_command": "test -z \"$(gofmt -l .)\"",
      "fix_command": "gofmt -w ."
    },
    "ci": {
      "platform": "GitHub Actions",
      "pipeline_steps": [
        "go mod download",
        "go build ./...",
        "go vet ./...",
        "go vet -tags=integration ./...",
        "GOOS=darwin GOARCH=amd64 go vet ./...",
        "golangci-lint run (golangci-lint-action)",
        "go test -v ./internal/browser -run ^TestChromeMeetingEndToEnd$",
        "go test -race -coverprofile=coverage.out ./...",
        "go tool cover -func=coverage.out"
      ],
      "quality_gates": [
        "go vet ./...",
        "golangci-lint run",
        "test -z \"$(gofmt -l .)\"",
        "go test ./..."
      ],
      "path_filter_mode": "fail_closed_changes_job",
      "docs_only_paths": [
        "**/*.md",
        "docs/**",
        ".backlogit/**",
        ".gsd/**"
      ]
    },
    "local_gating": {
      "pre_push_enabled": true,
      "pre_push_gates": [
        "format",
        "lint",
        "test",
        "build"
      ]
    },
    "repo": {
      "owner": "softwaresalt",
      "name": "go-teams"
    },
    "structure": {
      "source_layout": "cmd/go-teams/, internal/{audio,browser,capture,cli,config,scheduler,teams,transcript}/",
      "test_layout": "co-located *_test.go files",
      "doc_layout": "docs/design-docs/, docs/product-specs/"
    },
    "runtime_surfaces": {
      "cli": true,
      "web_ui": false,
      "public_api": false,
      "background_jobs": true,
      "browser_tooling": [
        "chromedp"
      ],
