# Line-ending normalization.
#
# Without this file a Windows checkout with core.autocrlf=true rewrites every
# tracked text file to CRLF in the working tree. `gofmt` only accepts LF, so it
# reports all *.go files as unformatted and the local format quality gate can
# never pass on Windows. Shell scripts likewise fail on Unix when checked out
# with CRLF.
#
# Committed blobs are already LF, so these rules change the working tree only —
# no blob content changes.

* text=auto

*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf

*.ps1      text eol=crlf

*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.mp3      binary
*.exe      binary
