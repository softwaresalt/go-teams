# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
diff.txt

# Directories
bin/
logs/
transcripts/
.vscode/
.copilot/
.mcp.json

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
coverage
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local environment files (secrets) — never commit. Only .env.example may be tracked.
.env
.env.*
!.env.example

# Plugin .mcp.json is intentionally tracked (distinct from local dev config)
!plugin/.mcp.json

# Editor/IDE
# .idea/
# .vscode/

# Advisory file locks (autoharness concurrency protocol)
.*.lock
**/.*.lock

# Engram runtime data (keep templates/, registry.yaml, .version)
.engram/
!.engram/.version
!.engram/.workspace-id
!.engram/config.toml
!.engram/registry.yaml

# graphtor-docs — managed by graphtor-docs install
.graphtor/

# Ephemeral SQLite databases (always regenerated; never commit)
backlogit.db
.backlogit/backlogit.db
.backlogit/backlogit.db-shm
.backlogit/backlogit.db-wal
.backlogit/.telemetry-checkpoint.json

# Runtime state (per-consumer checkpoints, not committed)
.backlogit/runtime/
.backlogit/.locks/
.autoharness/staging/
.autoharness/backups/
prompt.md
*.code-workspace
