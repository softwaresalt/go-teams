    },
    "runtime_validation": {
      "validator_manifest": {
        "surfaces": [
          {
            "surface": "cli",
            "adapter_hint": "command",
            "probe_hints": [
              {
                "id": "cli-help",
                "kind": "command",
                "target": "go-teams root command",
                "command": "go run ./cmd/go-teams --help",
                "expected_signal": "usage text lists auth, join, and schedule subcommands",
                "required": true,
                "evidence_types": [
                  "stdout",
                  "exit-code"
                ],
                "notes": "cmd/go-teams is scaffolded; this probe is executable today."
              },
              {
                "id": "cli-build",
                "kind": "command",
                "target": "module build",
                "command": "go build ./...",
                "expected_signal": "exit code 0",
                "required": true,
                "evidence_types": [
                  "exit-code",
                  "stdout"
                ]
              }
            ],
            "manual_checkpoints": [
              {
                "id": "teams-auth-mfa",
                "label": "Microsoft Teams interactive login and MFA",
                "reason": "Teams authentication cannot be automated; a human must complete login/MFA so the UserDataDir session is persisted.",
                "required_for_release": true,
                "evidence_types": [
                  "operator-note",
                  "screenshot"
                ],
                "fallback": "Record BLOCKED runtime evidence when no operator is available to complete the auth flow."
              }
            ]
          },
          {
            "surface": "background-job",
            "adapter_hint": "job",
            "probe_hints": [
              {
                "id": "scheduler-dry-run",
                "kind": "command",
                "target": "go-teams schedule command surface",
                "command": "go run ./cmd/go-teams schedule --help",
                "expected_signal": "schedule usage text renders and exits 0 without starting a browser",
                "required": false,
                "evidence_types": [
                  "stdout",
                  "exit-code"
                ],
                "notes": "The schedule command takes no flags (cobra.NoArgs); --help is the only non-blocking probe. Replace with a real --dry-run probe if one is added."
              },
              {
                "id": "scheduler-liveness-log",
                "kind": "log-check",
                "target": "scheduler process log",
                "expected_signal": "daemon startup line followed by a scheduled-fire line",
                "required": false,
                "evidence_types": [
                  "log-line",
                  "artifact-link"
                ]
              }
            ],
            "manual_checkpoints": [
              {
                "id": "scheduled-meeting-join",
                "label": "End-to-end scheduled meeting join",
                "reason": "A real Teams meeting must exist and be joined on schedule to validate the daemon path.",
                "required_for_release": false,
                "evidence_types": [
                  "operator-note",
                  "screen-recording"
                ],
                "fallback": "Defer to a post-deploy observation window when no meeting is available."
              }
            ]
          }
        ]
      },
      "validation_expectations": {
        "required": true,
        "surfaces_expected": [
          "cli",
          "background-job"
        ],
        "minimum_verdict": "PASS_WITH_FOLLOW_UP",
        "preserve_invariants": [
          "Persisted UserDataDir session state stays inside the configured workspace root.",
          "No credentials, cookies, or tokens are written to committed files or logs.",
          "Transcript and audio artifacts are written only to the configured output directory."
        ],
        "release_blockers": [
          "CLI binary fails to build or the root command does not start.",
          "Authentication flow writes secrets outside the configured session directory.",
          "Scheduler daemon exits non-zero on startup."
        ]
      },
      "releasability": {
        "required": true,
        "status_when_satisfied": "READY_WITH_CONDITIONS",
        "required_evidence": [
          {
            "kind": "healthy-signal",
            "required": true,
            "description": "go build ./... and go test ./... succeed."
          },
          {
            "kind": "failure-signal",
            "required": true,
            "description": "Non-zero exit from the CLI root command or the scheduler daemon."
          },
          {
            "kind": "monitoring-plan",
            "required": true,
            "description": "Daemon liveness, cron fire success/failure counts, and output-directory disk usage."
          },
          {
            "kind": "rollback-trigger",
            "required": true,
            "description": "Scheduler daemon crash-loops or consecutive cron fires fail to produce a transcript."
          },
          {
            "kind": "rollback-procedure",
            "required": true,
            "description": "Stop the schedule daemon and revert to the previously released binary."
          },
          {
            "kind": "owner",
            "required": true,
            "description": "Operator responsible for the post-deploy observation window."
          },
          {
            "kind": "validation-window",
            "required": true,
            "description": "One full scheduled-meeting cycle after release."
          },
          {
            "kind": "follow-up",
            "required": false,
            "description": "Outstanding manual checkpoints deferred past release."
          }
        ]
      }
